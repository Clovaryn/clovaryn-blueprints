resource "aws_security_group" "alb" {
  name        = "{{ service.name }}-internal-alb"
  description = "Internal ALB access for {{ service.name }}"
  vpc_id      = var.vpc_id
}

resource "aws_security_group_rule" "alb_ingress" {
  type              = "ingress"
  from_port         = {{ service.container_port }}
  to_port           = {{ service.container_port }}
  protocol          = "tcp"
  cidr_blocks       = var.allowed_internal_cidr_blocks
  security_group_id = aws_security_group.alb.id
}

resource "aws_security_group_rule" "alb_egress_to_ecs" {
  type                     = "egress"
  from_port                = {{ service.container_port }}
  to_port                  = {{ service.container_port }}
  protocol                 = "tcp"
  source_security_group_id = aws_security_group.ecs_service.id
  security_group_id        = aws_security_group.alb.id
}

resource "aws_security_group" "ecs_service" {
  name        = "{{ service.name }}-ecs-service"
  description = "ECS service access for {{ service.name }}"
  vpc_id      = var.vpc_id
}

resource "aws_security_group_rule" "ecs_ingress_from_alb" {
  type                     = "ingress"
  from_port                = {{ service.container_port }}
  to_port                  = {{ service.container_port }}
  protocol                 = "tcp"
  source_security_group_id = aws_security_group.alb.id
  security_group_id        = aws_security_group.ecs_service.id
}

resource "aws_security_group_rule" "ecs_egress_internal" {
  type              = "egress"
  from_port         = 0
  to_port           = 0
  protocol          = "-1"
  cidr_blocks       = var.allowed_internal_cidr_blocks
  security_group_id = aws_security_group.ecs_service.id
}

