{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clovaryn.dev/packages/official/aws-private-ecs-backend/1.0.0/intent.schema.json",
  "title": "AWS Private ECS Backend Intent",
  "type": "object",
  "required": ["project", "packages", "inputs"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "environment"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      }
    },
    "packages": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^clovaryn/aws-private-ecs-backend@[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iac_target": {
          "type": "string",
          "enum": ["terraform", "opentofu"]
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["service", "network"],
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "required": ["name", "container_image", "container_port", "cpu", "memory", "desired_count"],
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "container_image": { "type": "string", "minLength": 1 },
            "container_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "cpu": { "type": "integer", "minimum": 1 },
            "memory": { "type": "integer", "minimum": 1 },
            "desired_count": { "type": "integer", "minimum": 1 }
          }
        },
        "network": {
          "type": "object",
          "required": ["exposure", "vpc_id", "private_subnet_ids", "public_subnet_ids", "allowed_cidr_blocks"],
          "additionalProperties": false,
          "properties": {
            "exposure": { "const": "internal_only" },
            "vpc_id": { "type": "string", "minLength": 1 },
            "private_subnet_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "public_subnet_ids": {
              "type": "array",
              "maxItems": 0,
              "items": { "type": "string" }
            },
            "allowed_cidr_blocks": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

