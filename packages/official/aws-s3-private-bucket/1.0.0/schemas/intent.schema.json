{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clovaryn.dev/packages/official/aws-s3-private-bucket/1.0.0/intent.schema.json",
  "title": "AWS S3 Private Bucket Intent",
  "type": "object",
  "required": ["project", "packages", "inputs"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "environment"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      }
    },
    "packages": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^clovaryn/aws-s3-private-bucket@[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iac_target": {
          "type": "string",
          "enum": ["terraform", "opentofu"]
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["storage"],
      "additionalProperties": false,
      "properties": {
        "storage": {
          "type": "object",
          "required": [
            "aws_region",
            "bucket_name",
            "versioning_enabled",
            "encryption_enabled",
            "block_public_access",
            "force_destroy"
          ],
          "additionalProperties": false,
          "properties": {
            "aws_region": { "type": "string", "minLength": 1 },
            "bucket_name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 63,
              "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
            },
            "versioning_enabled": { "type": "boolean" },
            "encryption_enabled": { "type": "boolean" },
            "block_public_access": { "type": "boolean" },
            "force_destroy": { "type": "boolean" },
            "tags": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

